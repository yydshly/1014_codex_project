# 复制为 .env.local 后填写密钥，不要提交本地配置。
# MINIMAX_ENV_FILE=F:/codex_project/.env.minimax
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn
MINIMAX_TEXT_MODEL=MiniMax-M3
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_VOICE=female-shaonv
# 可选：连接已经运行的 llama.cpp / Ollama 兼容服务，不会自动下载模型。
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=local-model
