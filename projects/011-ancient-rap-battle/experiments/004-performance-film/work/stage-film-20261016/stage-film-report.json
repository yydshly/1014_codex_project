  "caption_policy": {
    "text_source": "user-confirmed-full-song-lyrics",
    "timings": "existing-short-window-candidates-editorial-placement",
    "events": [
      {
        "id": "VA01",
        "text": "我携一身月色，踏过长安的墙",
        "start": 9.84,
        "end": 14.12,
        "actor_reference": "李白",
        "timing_status": "short-window-supported"
      },
      {
        "id": "VA02",
        "text": "袖里藏着清风，胸口住着汪洋",
        "start": 15.08,
        "end": 18.64,
        "actor_reference": "李白",
        "timing_status": "short-window-supported"
      },
      {
        "id": "VA03",
        "text": "把失意酿成酒，把夜色唱到亮",
        "start": 19.64,
        "end": 23.24,
        "actor_reference": "李白",
        "timing_status": "phonetic-approximation"
      },
      {
        "id": "VA04",
        "text": "今夜借你鼓点，让天地听我讲",
        "start": 24.28,
        "end": 27.98,
        "actor_reference": "李白",
        "timing_status": "phonetic-approximation"
      },
      {
        "id": "VB01",
        "text": "我从长街走来，听过万户的忙",
        "start": 28.9,
        "end": 32.6,
        "actor_reference": "杜甫",
        "timing_status": "short-window-supported-start-uncertain"
      },
      {
        "id": "VB03",
        "text": "有人仰望星河，有人守着炉膛",
        "start": 33.34,
        "end": 37.88,
        "actor_reference": "杜甫",
        "timing_status": "short-window-supported"
      },
      {
        "id": "VB04",
        "text": "我让无名的脸，站到舞台中央",
        "start": 38.2,
        "end": 42.26,
        "actor_reference": "杜甫",
        "timing_status": "phonetic-approximation"
      },
      {
        "id": "C1A01",
        "text": "酒杯一举，银河都来捧场",
        "start": 42.26,
