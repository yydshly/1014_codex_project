# MiniMax 密钥仅由本地服务读取；不要使用 VITE_ 前缀。
MINIMAX_API_KEY=
# 可引用现有环境文件，例如 F:/codex_project/.env.minimax。
MINIMAX_ENV_FILE=
# 留空默认 api.minimax.cn；国际账户可设为 https://api.minimax.io。
MINIMAX_BASE_URL=
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_TEXT_MODEL=MiniMax-M3
# 可选：覆盖六个角色的官方系统音色。
MINIMAX_VOICE_MORI=male-qn-jingying
MINIMAX_VOICE_AMBER=male-qn-daxuesheng
MINIMAX_VOICE_INDIGO=male-qn-qingse
MINIMAX_VOICE_LUNA=female-chengshu
MINIMAX_VOICE_MOMO=female-shaonv
MINIMAX_VOICE_SLEEPY=female-yujie

# 原仓库默认本机独立目录，不需要 Docker/云账号；具有当前用户权限。
LOFI_SANDBOX_PROVIDER=local
# 引用已有本地文件，密钥不必发到聊天中。
LOFI_SANDBOX_ENV_FILE=
# Docker 不在标准位置时填 docker.exe 的绝对路径。
LOFI_DOCKER_PATH=
# 可选云模式 provider=vercel 时，凭据任选OIDC，或TOKEN+TEAM_ID+PROJECT_ID。
VERCEL_OIDC_TOKEN=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
