{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evidence-research-lab:report:v1",
  "title": "决策简报接口草案",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "run_id",
    "arm",
    "status",
    "model_snapshot",
    "input_manifest_sha256",
    "scope",
    "findings",
    "hypotheses",
    "predictions",
    "limitations",
    "measurements"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "arm": {
      "enum": [
        "A_live_web",
        "B_same_corpus",
        "C_evidence",
        "D_simulation"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "partial",
        "completed",
        "failed"
      ]
    },
    "model_snapshot": {
      "type": "string",
      "minLength": 1
    },
    "input_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "hypotheses": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/hypothesis"
      }
    },
    "predictions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prediction"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_tokens",
        "total_usd",
        "elapsed_seconds",
        "human_active_minutes",
        "includes_all_pipeline_steps"
      ],
      "properties": {
        "total_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "elapsed_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "human_active_minutes": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "includes_all_pipeline_steps": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "evidence_id": {
      "type": "string",
      "pattern": "^E[0-9]{4,}$"
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "statement",
        "kind",
        "evidence_ids",
        "counterevidence_ids",
        "unknowns",
        "next_validation",
        "review_status"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "observed",
            "user_self_report",
            "vendor_claim",
            "inferred"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence_id"
          }
        },
        "counterevidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence_id"
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_validation": {
          "type": "string",
          "minLength": 1
        },
        "review_status": {
          "enum": [
            "pending",
            "verified",
            "rejected"
          ]
        }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis_id",
        "kind",
        "statement",
        "persona_ids",
        "basis_evidence_ids",
        "falsification_test"
      ],
      "properties": {
        "hypothesis_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "simulated"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "persona_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "basis_evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence_id"
          }
        },
        "falsification_test": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_key",
        "question_id",
        "choice",
        "abstained"
      ],
      "properties": {
        "participant_key": {
          "type": "string",
          "minLength": 1
        },
        "question_id": {
          "type": "string",
          "minLength": 1
        },
        "choice": {
          "type": [
            "string",
            "null"
          ]
        },
        "abstained": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "abstained": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "choice": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "choice": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "items": {
              "properties": {
                "review_status": {
                  "const": "verified"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "arm": {
            "enum": [
              "A_live_web",
              "B_same_corpus",
              "C_evidence"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "hypotheses": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
