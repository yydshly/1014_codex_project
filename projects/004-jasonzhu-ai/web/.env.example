# 可引用本地已有的 OpenAI API 配置，密钥只在服务端读取。
OPENAI_ENV_FILE=
# 不引用已有文件时，在本地 .env.local 中配置：
OPENAI_API_KEY=
# 官方 web_search 文档示例模型；实际账户访问需要 API 验证。
OPENAI_MODEL=gpt-6-astra

# 自动研究使用本机正常登录的 Codex；不填写登录令牌。
# 留空从 PATH 查找实际二进制（Windows: codex.exe）。
CODEX_BIN=
# 留空使用 Codex 默认模型。
CODEX_MODEL=
RESEARCH_TIMEOUT_MS=240000
